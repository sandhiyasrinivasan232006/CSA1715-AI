from sklearn.cluster import KMeans
import numpy as np

# Dataset
X = np.array([
    [1, 2], [2, 3], [3, 4],
    [8, 9], [9, 10], [10, 11]
])

# Create KMeans model
model = KMeans(n_clusters=2, random_state=42, n_init=10)

# Train model
model.fit(X)

# Display clusters
print("Cluster Labels:")
print(model.labels_)

print("Cluster Centers:")
print(model.cluster_centers_)
