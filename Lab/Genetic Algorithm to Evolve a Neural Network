import numpy as np
import random

# XOR dataset
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

y = np.array([[0], [1], [1], [0]])

# Activation function
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# Neural network
def predict(weights, X):

    W1 = weights[:6].reshape(2, 3)
    W2 = weights[6:].reshape(3, 1)

    hidden = sigmoid(np.dot(X, W1))
    output = sigmoid(np.dot(hidden, W2))

    return output

# Fitness function
def fitness(weights):

    output = predict(weights, X)

    error = np.mean((y - output) ** 2)

    return 1 / (1 + error)

# Initial population
population = [
    np.random.uniform(-2, 2, 9)
    for i in range(20)
]

# Genetic algorithm
for generation in range(100):

    population.sort(key=fitness, reverse=True)

    parents = population[:5]

    new_population = parents.copy()

    while len(new_population) < 20:

        p1, p2 = random.sample(parents, 2)

        child = (p1 + p2) / 2

        # Mutation
        child += np.random.normal(0, 0.1, 9)

        new_population.append(child)

    population = new_population

# Best solution
best = max(population, key=fitness)

print("Best Fitness:", fitness(best))

print("Predicted XOR Output:")
print(np.round(predict(best, X)))
