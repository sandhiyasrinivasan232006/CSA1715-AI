import random

# Fitness function
def fitness(x):
    return x * x

# Initial population
population = [random.randint(0, 10) for i in range(5)]

# Genetic algorithm
for generation in range(10):

    population.sort(key=fitness, reverse=True)

    # Select best individuals
    parents = population[:2]

    # Crossover
    child = (parents[0] + parents[1]) // 2

    # Mutation
    child += random.choice([-1, 0, 1])
    child = max(0, min(10, child))

    population = parents + [child] + population[2:4]

best = max(population, key=fitness)

print("Best Solution:", best)
print("Maximum Fitness:", fitness(best))
